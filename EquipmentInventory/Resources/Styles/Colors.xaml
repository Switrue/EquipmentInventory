<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Background">#282e38</SolidColorBrush>
    <SolidColorBrush x:Key="Foreground">#24272f</SolidColorBrush>
    <SolidColorBrush x:Key="Circuit">#3a4456</SolidColorBrush>
    <SolidColorBrush x:Key="AccentColor">#d77a8a</SolidColorBrush>
    <SolidColorBrush x:Key="HintColor">#a1a3a8</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryColor">#768f9b</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryColor">#00c6dc</SolidColorBrush>
    <SolidColorBrush x:Key="TextColor">white</SolidColorBrush>

    <LinearGradientBrush x:Key="GradientBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#282e38" Offset="0.0" />
        <GradientStop Color="#313947" Offset="0.5" />
        <GradientStop Color="#3a4456" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientTransparent" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B0D0D0D0" Offset="0.0" />
        <GradientStop Color="#A0B0B0B0" Offset="0.25" />
        <GradientStop Color="#B0D0D0D0" Offset="0.5" />
        <GradientStop Color="#A0B0B0B0" Offset="0.75" />
        <GradientStop Color="#B0D0D0D0" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>