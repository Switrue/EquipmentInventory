<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Background" Color="#282e38" />
    <SolidColorBrush x:Key="Foreground" Color="#24272f" />
    <SolidColorBrush x:Key="Circuit" Color="#3a4456" />
    <SolidColorBrush x:Key="AccentColor" Color="#d77a8a" />
    <SolidColorBrush x:Key="HintColor" Color="#a1a3a8" />
    <SolidColorBrush x:Key="PrimaryColor" Color="#768f9b" />
    <SolidColorBrush x:Key="SecondaryColor" Color="#00c6dc" />
    <SolidColorBrush x:Key="TextColor" Color="white" />

    <LinearGradientBrush x:Key="GradientBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#282e38" Offset="0.0" />
        <GradientStop Color="#313947" Offset="0.5" />
        <GradientStop Color="#3a4456" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientTransparent" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B0D0D0D0" Offset="0.0" />
        <GradientStop Color="#A0B0B0B0" Offset="0.25" />
        <GradientStop Color="#B0D0D0D0" Offset="0.5" />
        <GradientStop Color="#A0B0B0B0" Offset="0.75" />
        <GradientStop Color="#B0D0D0D0" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>