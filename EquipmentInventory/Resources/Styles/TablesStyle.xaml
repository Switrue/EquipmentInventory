<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="BaseDataTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="Transparent" />
    </Style>

    <Style x:Key="BaseDataTextBlock" TargetType="TextBlock">
        <Setter Property="MaxWidth" Value="200" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IconDataTextBox" TargetType="TextBox" BasedOn="{StaticResource BaseDataTextBox}">
        <Setter Property="materialDesign:TextFieldAssist.HasLeadingIcon" Value="True" />
    </Style>

    <Style x:Key="BaseDataBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource HintColor}" />
        <Setter Property="Margin" Value="5 3 5 3" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatSecondaryButton}">
        <Setter Property="Padding" Value="5" />
        <Setter Property="Margin" Value="5 0 0 0" />
    </Style>
</ResourceDictionary>