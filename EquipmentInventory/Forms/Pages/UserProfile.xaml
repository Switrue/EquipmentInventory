<Page x:Class="EquipmentInventory.Forms.Pages.UserProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EquipmentInventory.Forms.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      Background="Transparent"
      MouseDown="Page_MouseDown"
      d:DesignHeight="450" d:DesignWidth="800">

    <!--#region Styles-->
    
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/UserStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style TargetType="GroupBox" BasedOn="{StaticResource MaterialDesignCardGroupBox}">
                <Setter Property="Margin" Value="0 20 0 0" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="Background" Value="{StaticResource Background}" />
                <Setter Property="materialDesign:ColorZoneAssist.Background" Value="{StaticResource PrimaryColor}" />
                <Setter Property="materialDesign:ColorZoneAssist.Foreground" Value="{StaticResource TextColor}" />
                <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="Custom" />
                <Setter Property="materialDesign:GroupBoxAssist.HeaderPadding" Value="5" />
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4" />
            </Style>
            
            <Style TargetType="materialDesign:PackIcon" >
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TitleGroupBox" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignSubtitle1TextBlock}">
                <Setter Property="Margin" Value="8 0 0 0" />
                <Setter Property="Text" Value="{Binding}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    
    <!--#endregion-->

    <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="800" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        
            <!--#region User profile-->

            <StackPanel Grid.Row="0" Grid.Column="1">
                <WrapPanel Orientation="Vertical" Margin="0,20" VerticalAlignment="Center">
                    <TextBlock x:Name="userTitleTxtBl"
                               Foreground="{StaticResource TextColor}"
                               Style="{StaticResource MaterialDesignDisplaySmallTextBlock}" />
                    <TextBlock x:Name="userRoleTxtBl"
                               Foreground="{StaticResource HintColor}"
                               Style="{StaticResource MaterialDesignLabelLargeTextBlock}" />
                </WrapPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                <Border BorderBrush="{StaticResource SecondaryColor}" BorderThickness="1" />
            </StackPanel>

            <!--#region GroupBox-->

            <StackPanel Grid.Row="1" Grid.Column="1">
                <!--#region Image-->

                <GroupBox x:Name="imageGrB">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Image" />
                                <TextBlock Style="{StaticResource TitleGroupBox}" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <UniformGrid Rows="2">
                        <WrapPanel>
                            <Image x:Name="userImage" Source="/Resources/Pictures/SmallUserIcon.png" HorizontalAlignment="Left" />
                            <Button x:Name="changeImageBtn" Margin="10" Click="ChangeImage_Click" />
                        </WrapPanel>

                        <UniformGrid Columns="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button x:Name="saveUserImage" Margin="0 0 5 0" />
                            <Button x:Name="cancelSaveUserImageBtn" Margin="5 0 0 0" Click="CancelSaveUserImage_Click" />
                        </UniformGrid>
                    </UniformGrid>
                </GroupBox>

                <!--#endregion-->

                <!--#region Data-->

                <GroupBox x:Name="dataGrB">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="User" />
                                <TextBlock Style="{StaticResource TitleGroupBox}" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <UniformGrid Rows="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="userDataContainer" Grid.Column="0">
                                <UniformGrid x:Name="usernameContainer" Columns="2">
                                    <TextBox x:Name="usernameTxtB" IsEnabled="False" TextChanged="ValidBox_TextChanged" />
                                    <TextBox x:Name="surnameTxtB" IsEnabled="False" TextChanged="ValidBox_TextChanged" />
                                </UniformGrid>
                                <StackPanel x:Name="userPasswordContainer">
                                    <TextBox x:Name="userPasswordTxtB" IsEnabled="False" TextChanged="ValidBox_TextChanged" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="editBtnContainer" Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="editUsernameBtn" 
                                        Content="{materialDesign:PackIcon Kind=Edit,Size=20}"
                                        Click="EditUsername_Click" />
                                <Button x:Name="editUserPasswordBtn" 
                                        Content="{materialDesign:PackIcon Kind=Edit,Size=20}"
                                        Click="EditUserPassword_Click" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button x:Name="saveUserDataBtn" Margin="0 0 5 0" Click="SaveUserData_Click" />
                            <Button x:Name="cancelSaveUserDataBtn" Margin="5 0 0 0" Click="CancelSaveUserData_Click" />
                        </UniformGrid>
                    </UniformGrid>
                </GroupBox>

                <!--#endregion-->
            </StackPanel>

            <!--#endregion-->
        
            <!--#endregion-->
        </Grid>
    </ScrollViewer>
</Page>
