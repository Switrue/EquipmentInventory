<Page x:Class="EquipmentInventory.Forms.Pages.ProgramInformation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EquipmentInventory.Forms.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      Background="Transparent"
      MouseDown="Page_MouseDown"
      d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--#region Program information block-->
        
        <StackPanel Grid.Column="0" Background="{StaticResource Background}">
            <ListView x:Name="informationListV"
                      Focusable="False"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      Foreground="{StaticResource TextColor}"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding TabHeader}" Width="180" MaxHeight="50" TextTrimming="WordEllipsis" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
        
        <Border BorderBrush="{StaticResource SecondaryColor}" BorderThickness="2" Width="2" HorizontalAlignment="Right" />
        
        <Grid Grid.Column="1" VerticalAlignment="Top">
            <GroupBox x:Name="titleTextGroupBox"
                      Margin="16"
                      materialDesign:ElevationAssist.Elevation="Dp4"
                      BorderThickness="0"
                      materialDesign:ColorZoneAssist.Background="{StaticResource PrimaryColor}"
                      materialDesign:ColorZoneAssist.Foreground="{StaticResource TextColor}"
                      materialDesign:ColorZoneAssist.Mode="Custom"
                      Style="{StaticResource MaterialDesignGroupBox}">
                <TextBox x:Name="descriptionTxtB" 
                         VerticalAlignment="Stretch"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         Padding="15"
                         ContextMenu="{x:Null}"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         BorderBrush="Transparent"
                         materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                         Foreground="{StaticResource TextColor}" />
            </GroupBox>
        </Grid>
        
        <!--#endregion-->
    </Grid>
</Page>
