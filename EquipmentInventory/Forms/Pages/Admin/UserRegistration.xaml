<Page x:Class="EquipmentInventory.Forms.Pages.UserRegistration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EquipmentInventory.Forms.Pages.Admin"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="Transparent"
      MouseDown="Page_MouseDown"
      d:DesignHeight="450" d:DesignWidth="800">

    <!--#region Styles-->
    
    <Page.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="Margin" Value="7" />
                <Setter Property="Foreground" Value="{StaticResource TextColor}" />
                <Setter Property="BorderBrush" Value="{StaticResource HintColor}" />
                <Setter Property="MaxLength" Value="60" />
                <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="IsEnabled" Value="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" />
                <Setter Property="Foreground" Value="{StaticResource HintColor}" />
                <Setter Property="Height" Value="25" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    
    <!--#endregion-->

    <Grid>
        <!--#region Resistration unit-->

        <materialDesign:Card Background="{StaticResource Background}" 
                BorderThickness="2 0 2 0" 
                BorderBrush="{StaticResource SecondaryColor}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                materialDesign:ElevationAssist.Elevation="Dp16"
                UniformCornerRadius="25">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="10" Focusable="False">
                <Grid Margin="40 10 40 10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="80" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <Image Source="/Resources/Pictures/SmallUserIcon.png" Width="80" Height="80" HorizontalAlignment="Left" />
                        <StackPanel Margin="10">
                            <Button x:Name="changeImageBtn" />
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border BorderBrush="{StaticResource HintColor}" BorderThickness="2" Height="2" />
                        <TextBlock x:Name="titleUserTxtBl" Style="{StaticResource MaterialDesignTitleLargeTextBlock}" Foreground="{StaticResource TextColor}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Width="250">
                        <StackPanel>
                            <TextBox x:Name="userFieldTxtB" />
                            <TextBox x:Name="surnameFieldTxtB" />
                            <TextBox x:Name="loginFieldTxtB" />
                            <TextBox x:Name="passwordFieldTxtB" />
                        </StackPanel>
                        <UniformGrid Margin="7 20 7 0" Columns="2">
                            <ToggleButton x:Name="hidePasswordTglBtn"
                                          Content="{materialDesign:PackIcon Kind=Hide,Size=18}"
                                          IsChecked="True"
                                          Focusable="False"
                                          Height="25"
                                          Width="25"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}" />
                            <Button x:Name="passwordGenerationBtn" />
                        </UniformGrid>
                    </StackPanel>

                    <Button x:Name="createAccountBtn" 
                            Grid.Row="4" 
                            Width="250" 
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                            Click="Button_Click" />
                </Grid>
            </ScrollViewer>
        </materialDesign:Card>
        <materialDesign:Snackbar x:Name="notificationSnackbar"
                                 Grid.ColumnSpan="3"
                                 HorizontalAlignment="Stretch"
                                 MessageQueue="{materialDesign:MessageQueue}"
                                 Background="{StaticResource Background}" />
        
        <!--#endregion-->
    </Grid>
</Page>
