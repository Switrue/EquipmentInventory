<Page x:Class="EquipmentInventory.Forms.Pages.UserRegistration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EquipmentInventory.Forms.Pages.Admin"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Background="Transparent"
      MouseDown="Page_MouseDown"
      d:DesignHeight="450" d:DesignWidth="800">
    <!--#region Styles-->
    
    <Page.Resources>
        <ResourceDictionary Source="/Resources/Styles/UserStyles.xaml" />
    </Page.Resources>
    
    <!--#endregion-->

    <Grid>
        <!--#region Resistration unit-->

        <materialDesign:Card Background="{StaticResource Background}" 
                             BorderThickness="2 0 2 0" 
                             BorderBrush="{StaticResource SecondaryColor}"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             materialDesign:ElevationAssist.Elevation="Dp16"
                             UniformCornerRadius="25">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="10" Focusable="False">
                <Grid Margin="40 10 40 10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="80" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <Image x:Name="userImage" Source="/Resources/Pictures/SmallUserIcon.png" HorizontalAlignment="Left" />
                        <Button x:Name="changeImageBtn" Margin="10" Click="ChangeImage_Click" />
                    </WrapPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border BorderBrush="{StaticResource HintColor}" BorderThickness="2" Height="2" />
                        <TextBlock x:Name="titleUserTxtBl" Style="{StaticResource MaterialDesignTitleLargeTextBlock}" Foreground="{StaticResource TextColor}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Width="250">
                        <StackPanel x:Name="textFieldContainer">
                            <TextBox x:Name="userFieldTxtB" TextChanged="ValidBox_TextChanged" />
                            <TextBox x:Name="surnameFieldTxtB" TextChanged="ValidBox_TextChanged" />
                            <TextBox x:Name="loginFieldTxtB" TextChanged="ValidBox_TextChanged" />
                            <TextBox x:Name="passwordFieldTxtB" TextChanged="ValidBox_TextChanged" />
                        </StackPanel>
                        <Button x:Name="passwordGenerationBtn" HorizontalAlignment="Right" Margin="0 15 7 0" Click="PasswordGeneration_Click" />
                    </StackPanel>

                    <Button x:Name="createAccountBtn" 
                            Grid.Row="4" 
                            Width="250" 
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                            Click="CreateAccount_Click" />
                </Grid>
            </ScrollViewer>
        </materialDesign:Card>
        <materialDesign:Snackbar x:Name="notificationSnackbar"
                                 Grid.ColumnSpan="3"
                                 HorizontalAlignment="Stretch"
                                 MessageQueue="{materialDesign:MessageQueue}"
                                 Background="{StaticResource Background}" />
        
        <!--#endregion-->
    </Grid>
</Page>
