<Page x:Class="EquipmentInventory.Forms.Pages.Inventory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EquipmentInventory.Forms.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      MouseDown="Page_MouseDown"
      Background="Transparent"
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--#region Search panel-->
        
        <materialDesign:DrawerHost Grid.Column="0" OpenMode="Standard" IsLeftDrawerOpen="True">
            <materialDesign:DrawerHost.Style>
                <Style TargetType="materialDesign:DrawerHost" BasedOn="{StaticResource {x:Type materialDesign:DrawerHost}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=BackgroundToggle}" Value="True">
                            <Setter Property="OverlayBackground" Value="{DynamicResource PrimaryHueMidBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </materialDesign:DrawerHost.Style>
            <materialDesign:DrawerHost.LeftDrawerContent>
                <Grid Background="{StaticResource Background}">
                    <Grid Grid.Column="0" Width="260" Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <!--#region Search-->

                        <StackPanel Grid.Row="0">
                            <TextBox x:Name="searchTxtB"
                                     materialDesign:HintAssist.Hint="Поиск"
                                     Margin="0 0 0 15"
                                     materialDesign:HintAssist.HintPaddingBrush="{StaticResource Background}"
                                     AcceptsReturn="True"
                                     FontSize="14"
                                     BorderBrush="{StaticResource TextColor}"
                                     Foreground="{StaticResource TextColor}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        </StackPanel>

                        <!-- #endregion -->

                        <!--#region Filters-->

                        <Grid Grid.Row="1" Margin="0 15 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="viewFiltersBtn" Content="Показать" Grid.Column="0"
                                    IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                    Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                                    Tag="true"
                                    Click="ExpendFilters_Click" />
                            <Button x:Name="hidenFiltersBtn" Content="Скрыть" Grid.Column="2"
                                    IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                    Style="{StaticResource MaterialDesignRaisedSecondaryButton}" 
                                    Click="ExpendFilters_Click" />
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Focusable="False" Margin="-15 5 -15 0">
                            <materialDesign:Card Background="{StaticResource Background}" 
                                                 materialDesign:ElevationAssist.Elevation="Dp0"
                                                 IsTabStop="False">
                                <StackPanel x:Name="filterContainer">
                                    <Expander x:Name="techniqueExpander" HorizontalAlignment="Stretch" Header="Техника"
                                              Background="{StaticResource Background}"
                                              Foreground="{StaticResource TextColor}">
                                        <StackPanel Margin="24 8 24 16">
                                            <RadioButton x:Name="techNameRBtn" Content="Наименование" Style="{StaticResource RadioButtonFilter}" />
                                            <RadioButton x:Name="techTypeRBtn" Content="Тип" Style="{StaticResource RadioButtonFilter}" />
                                            <RadioButton x:Name="techNumberRBtn" Content="Инвентарный номер" Style="{StaticResource RadioButtonFilter}" />
                                            <RadioButton x:Name="techCostRBtn" Content="Стоимость" Style="{StaticResource RadioButtonFilter}" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                    <Expander x:Name="responsibleExpander" HorizontalAlignment="Stretch" Header="Ответственный"
                                              Background="{StaticResource Background}"
                                              Foreground="{StaticResource TextColor}">
                                        <StackPanel Margin="24 8 24 16">
                                            <RadioButton x:Name="respEmployeeRBtn" Content="Сотрудник" Style="{StaticResource RadioButtonFilter}" />
                                            <RadioButton x:Name="respNumberRBtn" Content="Номер кабинета" Style="{StaticResource RadioButtonFilter}" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                    <Expander x:Name="computerExpander" HorizontalAlignment="Stretch" Header="Компьютер"
                                              Background="{StaticResource Background}"
                                              Foreground="{StaticResource TextColor}">
                                        <StackPanel Margin="24 8 24 16">
                                            <RadioButton x:Name="compNumberRBtn" Content="Номер" Style="{StaticResource RadioButtonFilter}" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                    <Expander x:Name="dateExpander" HorizontalAlignment="Stretch" Header="Дата"
                                              Background="{StaticResource Background}"
                                              Foreground="{StaticResource TextColor}">
                                        <StackPanel Margin="24 8 24 16">
                                            <RadioButton x:Name="dateAcquisitionRBtn" Content="Приобретения" Style="{StaticResource RadioButtonFilter}" />
                                            <RadioButton x:Name="dateProductionsRBtn" Content="Производства" Style="{StaticResource RadioButtonFilter}" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                    <Expander x:Name="suppliersExpander" HorizontalAlignment="Stretch" Header="Поставщики"
                                              Background="{StaticResource Background}"
                                              Foreground="{StaticResource TextColor}">
                                        <StackPanel Margin="24 8 24 16">
                                            <RadioButton x:Name="supNameRBtn" Content="Наименование" Style="{StaticResource RadioButtonFilter}" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                </StackPanel>
                            </materialDesign:Card>
                        </ScrollViewer>

                        <!-- #endregion -->

                        <!--#region Control panel-->

                        <StackPanel Grid.Row="3">
                            <materialDesign:DrawerHost Margin="0 0 0 10" OpenMode="Standard" BottomDrawerBackground="{DynamicResource SecondaryHueLightBrush}">
                                <materialDesign:DrawerHost.Style>
                                    <Style TargetType="materialDesign:DrawerHost" BasedOn="{StaticResource {x:Type materialDesign:DrawerHost}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=BackgroundToggle}" Value="True">
                                                <Setter Property="OverlayBackground" Value="{DynamicResource PrimaryHueMidBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:DrawerHost.Style>
                                <materialDesign:DrawerHost.BottomDrawerContent>
                                    <StackPanel Background="Transparent">
                                        <ComboBox x:Name="OutlinedComboBox"
                                                  Foreground="{StaticResource TextColor}"
                                                  FontSize="14"
                                                  materialDesign:ThemeAssist.Theme="Dark"
                                                  materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource TextColor}"
                                                  materialDesign:HintAssist.Hint="Выбор запроса"
                                                  ItemsSource="{Binding ShortStringList}">
                                            <ComboBoxItem Content="Пример 1" />
                                            <ComboBoxItem Content="Пример 2" />
                                        </ComboBox>

                                        <Grid Margin="0 15 0 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Отсутствует:" Grid.Column="0" Grid.Row="0" Foreground="{StaticResource TextColor}" VerticalAlignment="Center" />
                                            <ListBox Style="{StaticResource MaterialDesignChoiceChipOutlineListBox}" Grid.Column="2" Grid.Row="0">
                                                <ListBoxItem Foreground="{StaticResource TextColor}" Content="{materialDesign:PackIcon Kind=Check, Size=15}" />
                                                <ListBoxItem Foreground="{StaticResource TextColor}" Content="{materialDesign:PackIcon Kind=Minus, Size=15}" IsSelected="True" />
                                                <ListBoxItem Foreground="{StaticResource TextColor}" Content="{materialDesign:PackIcon Kind=Close, Size=15}" />
                                            </ListBox>

                                            <TextBlock Text="В ремонте:" Grid.Column="0" Grid.Row="1" Foreground="{StaticResource TextColor}" VerticalAlignment="Center" />
                                            <ListBox Style="{StaticResource MaterialDesignChoiceChipOutlineListBox}" Grid.Column="2" Grid.Row="1">
                                                <ListBoxItem Foreground="{StaticResource TextColor}" Content="{materialDesign:PackIcon Kind=Check, Size=15}" />
                                                <ListBoxItem Foreground="{StaticResource TextColor}" Content="{materialDesign:PackIcon Kind=Minus, Size=15}" IsSelected="True" />
                                                <ListBoxItem Foreground="{StaticResource TextColor}" Content="{materialDesign:PackIcon Kind=Close, Size=15}" />
                                            </ListBox>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:DrawerHost.BottomDrawerContent>
                                <StackPanel Margin="0 0 9 0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ToggleButton Background="{DynamicResource SecondaryColor}"
                                                  materialDesign:ElevationAssist.Elevation="Dp3"
                                                  materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon ArrowCollapseDown}"
                                                  Content="{materialDesign:PackIcon Kind=ArrowExpandUp}"
                                                  Style="{StaticResource MaterialDesignActionToggleButton}"
                                                  CommandParameter="{x:Static Dock.Bottom}" Cursor="Hand"
                                                  Click="toggleGridBtn_Click" IsChecked="False" />
                                </StackPanel>
                            </materialDesign:DrawerHost>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>

                                <Button Content="Найти"
                                        Grid.Column="0"
                                        IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
                                <Button Content="{materialDesign:PackIcon Kind=CloseBoxOutline, Size=20}" 
                                        Grid.Column="2"
                                        ToolTip="Очистить"
                                        IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                        Style="{StaticResource MaterialDesignRaisedSecondaryButton}" />
                            </Grid>
                        </StackPanel>

                        <!-- #endregion -->
                    </Grid>
                    <Border Background="{StaticResource SecondaryColor}" HorizontalAlignment="Right" Width="2" />
                </Grid>
            </materialDesign:DrawerHost.LeftDrawerContent>
            <StackPanel Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                <ToggleButton x:Name="toggleGridBtn"
                              Background="{StaticResource SecondaryColor}"
                              materialDesign:ElevationAssist.Elevation="Dp3"
                              materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon ArrowCollapseLeft}"
                              Content="{materialDesign:PackIcon ArrowExpandRight}" 
                              Style="{StaticResource MaterialDesignActionToggleButton}"
                              CommandParameter="{x:Static Dock.Left}" Cursor="Hand"
                              Click="toggleGridBtn_Click" IsChecked="True" />
            </StackPanel>
        </materialDesign:DrawerHost>

        <!--#endregion-->

        <!--#region Table-->

        <Grid Grid.Column="1" Cursor="">
            <Button Content="Жми" Click="Button_Click" HorizontalAlignment="Center" />
        </Grid>

        <materialDesign:Snackbar x:Name="NotificationSnackbar" Grid.Column="1"
                                 Margin="-44 0 0 0"
                                 HorizontalAlignment="Stretch"
                                 MessageQueue="{materialDesign:MessageQueue}"
                                 Background="{StaticResource Background}" />

        <!--#endregion-->
    </Grid>
</Page>
