<Page x:Class="EquipmentInventory.Forms.Pages.Inventory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EquipmentInventory.Forms.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      MouseDown="Page_MouseDown"
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <materialDesign:DrawerHost Grid.Column="1"
                                   x:Name="DrawerHost"
                                   OpenMode="Standard"
                                   IsLeftDrawerOpen="True"
                                   BottomDrawerBackground="{DynamicResource SecondaryHueLightBrush}"
                                   BottomDrawerCornerRadius="20 20 0 0">
            <materialDesign:DrawerHost.Style>
                <Style TargetType="materialDesign:DrawerHost" BasedOn="{StaticResource {x:Type materialDesign:DrawerHost}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=BackgroundToggle}" Value="True">
                            <Setter Property="OverlayBackground" Value="{DynamicResource PrimaryHueMidBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </materialDesign:DrawerHost.Style>
            <materialDesign:DrawerHost.LeftDrawerContent>
                <Grid Grid.Column="0" Width="250" Background="{StaticResource Background}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="15" Grid.Row="0">
                        <TextBox materialDesign:HintAssist.Hint="Поиск"
                                 materialDesign:HintAssist.Background="{StaticResource Background}"
                                 materialDesign:HintAssist.HintPaddingBrush="{StaticResource Background}"
                                 AcceptsReturn="True"
                                 BorderBrush="{StaticResource TextColor}"
                                 Foreground="{StaticResource TextColor}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 VerticalScrollBarVisibility="Auto" />
                        <TextBlock x:Name="errorTextTxtBl" 
                                   Text="Ошибка" 
                                   Margin="10" 
                                   MaxHeight="50"
                                   Foreground="{StaticResource AccentColor}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <StackPanel>
                            <materialDesign:Card Background="{StaticResource Background}" 
                                                 materialDesign:ElevationAssist.Elevation="Dp0" 
                                                 IsTabStop="False">
                                <StackPanel>
                                    <Expander HorizontalAlignment="Stretch" Header="Техника"
                                              Background="{StaticResource Background}"
                                              Foreground="{StaticResource TextColor}">
                                        <StackPanel Margin="24,8,24,16"
                                                    Orientation="Vertical"
                                                    TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                                            <RadioButton Content="Название" Style="{StaticResource RadioButtonFilter}" />
                                            <RadioButton Content="Тип" Style="{StaticResource RadioButtonFilter}" />
                                            <RadioButton Content="Порядковый номер" Style="{StaticResource RadioButtonFilter}" />
                                            <RadioButton Content="Стоимость" Style="{StaticResource RadioButtonFilter}" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                    <Expander HorizontalAlignment="Stretch" Header="Закреплен"
                                              Background="{StaticResource Background}"
                                              Foreground="{StaticResource TextColor}">
                                        <StackPanel Margin="24,8,24,16"
                                                    Orientation="Vertical"
                                                    TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                                            <RadioButton Content="Сотрудник" Style="{StaticResource RadioButtonFilter}" />
                                            <RadioButton Content="Номер кабинета" Style="{StaticResource RadioButtonFilter}" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                    <Expander HorizontalAlignment="Stretch" Header="Компьютер"
                                              Background="{StaticResource Background}"
                                              Foreground="{StaticResource TextColor}">
                                        <StackPanel Margin="24,8,24,16"
                                                    Orientation="Vertical"
                                                    TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                                            <RadioButton Content="Номер" Style="{StaticResource RadioButtonFilter}" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                    <Expander HorizontalAlignment="Stretch" Header="Дата"
                                              Background="{StaticResource Background}"
                                              Foreground="{StaticResource TextColor}">
                                        <StackPanel Margin="24,8,24,16"
                                                    Orientation="Vertical"
                                                    TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                                            <RadioButton Content="Приобритения" Style="{StaticResource RadioButtonFilter}" />
                                            <RadioButton Content="Производства" Style="{StaticResource RadioButtonFilter}" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                    <Expander HorizontalAlignment="Stretch" Header="Поставщики"
                                              Background="{StaticResource Background}"
                                              Foreground="{StaticResource TextColor}">
                                        <StackPanel Margin="24,8,24,16"
                                                    Orientation="Vertical"
                                                    TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                                            <RadioButton Content="Наименование" Style="{StaticResource RadioButtonFilter}" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Background="{StaticResource SecondaryColor}" Grid.RowSpan="2" HorizontalAlignment="Right" Width="2" />
                </Grid>
            </materialDesign:DrawerHost.LeftDrawerContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="toggleGridBtn" Margin="5" Grid.Column="0"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon ArrowExpandLeft}"
                              Background="{StaticResource SecondaryColor}"
                              materialDesign:ElevationAssist.Elevation="Dp6"
                              Content="{materialDesign:PackIcon ArrowExpandRight}" IsTabStop="False"
                              Style="{StaticResource MaterialDesignActionToggleButton}"
                              CommandParameter="{x:Static Dock.Left}" Cursor="Hand"
                              Click="toggleGridBtn_Click" IsChecked="True" />
            </Grid>
        </materialDesign:DrawerHost>
    </Grid>
</Page>
