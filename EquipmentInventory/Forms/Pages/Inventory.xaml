<Page x:Class="EquipmentInventory.Forms.Pages.Inventory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EquipmentInventory.Forms.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      MouseDown="Page_MouseDown"
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="filterAreaGrid" Grid.Column="0" Width="250" Background="{StaticResource Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="15" Grid.Row="0">
                <TextBox materialDesign:HintAssist.Hint="Поиск"
                         AcceptsReturn="True"
                         BorderBrush="{StaticResource TextColor}"
                         Foreground="{StaticResource TextColor}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         VerticalScrollBarVisibility="Auto" />
                <TextBlock x:Name="errorTextTxtBl" 
                           Text="Ошибка" 
                           Margin="5" 
                           MaxHeight="50"
                           Foreground="{StaticResource AccentColor}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Row="1">
                
            </StackPanel>

            <Border Background="{StaticResource SecondaryColor}" Grid.RowSpan="2" HorizontalAlignment="Right" Width="2" />
        </Grid>

        <Button x:Name="toggleGridBtn" Grid.Column="1" Padding="0" IsTabStop="False"
                VerticalAlignment="Bottom" Margin="10" Background="{StaticResource SecondaryColor}"
                Content="{materialDesign:PackIcon ArrowExpandLeft}"
                Click="toggleGridBtn_Click"
                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" />
    </Grid>
</Page>
