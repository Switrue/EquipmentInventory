<UserControl x:Class="EquipmentInventory.Forms.Pages.GridTables.Archive"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EquipmentInventory.Classes.Data.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             Background="Transparent"
             d:DesignHeight="450" d:DesignWidth="800">
    <!--#region Styles-->
    <UserControl.Resources>
        <ResourceDictionary>
            <local:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/TablesStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--#endregion-->
    
    <Grid>
        <!--#region Items-->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}"
                          Background="Transparent"
                          Focusable="False"
                          Foreground="{StaticResource TextColor}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card BorderBrush="{StaticResource SecondaryColor}" 
                                             Background="{StaticResource Background}"
                                             UniformCornerRadius="10" 
                                             Margin="0 10 0 10"
                                             BorderThickness="2 0 2 0" >
                            <StackPanel Margin="10" Orientation="Vertical">
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="5" 
                                        Padding="2">
                                    <TextBox Text="{Binding Number}"
                                             Style="{StaticResource BaseDataTextBox}" />
                                </Border>

                                <TextBox Text="{Binding TechniqueName}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:ThemeAssist.Theme="Dark"
                                         IsReadOnly="True"
                                         Margin="0 10 0 10"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TypeTechniqueName}" 
                                               Style="{StaticResource BaseDataTextBlock}"/>
                                    <Border Style="{StaticResource BaseDataBorder}" />
                                    <TextBlock Text="{Binding Supplier}"
                                               Style="{StaticResource BaseDataTextBlock}" />
                                    <StackPanel Orientation="Horizontal" 
                                                Visibility="{Binding UnderRepair, 
                                                             Converter={StaticResource ValueToVisibilityConverter}}">
                                        <Border Style="{StaticResource BaseDataBorder}"/>
                                        <TextBlock Text="В ремонте"
                                                   Style="{StaticResource BaseDataTextBlock}" />
                                    </StackPanel>

                                </StackPanel>

                                <UniformGrid Columns="2" Margin="0 10 0 5">
                                    <StackPanel>
                                        <TextBox Text="{Binding WriteOffDate, StringFormat='Изменения: {0:dd.MM.yyyy}'}"
                                                 Style="{StaticResource IconDataTextBox}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="Calendar" />
                                        <TextBox Text="{Binding DateOfPurchase, StringFormat='Приобретения: {0:dd.MM.yyyy}'}"
                                                 Style="{StaticResource IconDataTextBox}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="Calendar" />
                                        <TextBox Text="{Binding DateOfManufacture, StringFormat='Произодства: {0:dd.MM.yyyy}'}" 
                                                 Style="{StaticResource IconDataTextBox}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="Calendar" />
                                        <TextBox Text="{Binding DateOfUse, StringFormat='Использования: {0:dd.MM.yyyy}'}"
                                                 Visibility="{Binding DateOfUse, Converter={StaticResource ValueToVisibilityConverter}}"
                                                 Style="{StaticResource IconDataTextBox}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="Calendar" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBox Text="{Binding MemberName}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="User"
                                                 Style="{StaticResource IconDataTextBox}"
                                                 Visibility="{Binding MemberName, Converter={StaticResource ValueToVisibilityConverter}}" />
                                        <TextBox Text="{Binding OfficeNumber}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="Door"
                                                 Style="{StaticResource IconDataTextBox}"
                                                 Visibility="{Binding OfficeNumber, Converter={StaticResource ValueToVisibilityConverter}}" />
                                        <TextBox Text="{Binding ComputerNumber}"
                                                 Style="{StaticResource IconDataTextBox}"
                                                 materialDesign:TextFieldAssist.LeadingIcon="ComputerClassic"
                                                 Visibility="{Binding ComputerNumber, Converter={StaticResource ValueToVisibilityConverter}}" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="{Binding Cost, StringFormat='Цена: {0:# ##0.##}'}"
                                           Language="ru-RU"
                                           Style="{StaticResource BaseDataTextBlock}" />
                            </StackPanel>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <!--#endregion-->
    </Grid>
</UserControl>
