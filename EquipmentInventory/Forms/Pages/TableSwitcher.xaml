<Page x:Class="EquipmentInventory.Forms.Pages.TableSwitcher"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EquipmentInventory.Forms.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      Background="Transparent"
      MouseDown="Page_MouseDown"
      d:DesignHeight="450" d:DesignWidth="800">
    <!--#region Styles-->
    
    <Page.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="Margin" Value="0 0 5 0" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="materialDesign:TextFieldAssist.HasLeadingIcon" Value="True" />
                <Setter Property="materialDesign:TextFieldAssist.LeadingIconSize" Value="15" />
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{StaticResource TextColor}" />
                <Setter Property="BorderBrush" Value="{StaticResource HintColor}" />
            </Style>
            
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedSecondaryButton}">
                <Setter Property="IsEnabled" Value="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" />
            </Style>
            
            <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignActionToggleButton}">
                <Setter Property="Background" Value="{StaticResource SecondaryColor}" />
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp3" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    
    <!--#endregion-->
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--#region Search panel-->
        
        <materialDesign:DrawerHost x:Name="searchPanelDrawerHost" Grid.Column="0" OpenMode="Standard" IsLeftDrawerOpen="True">
            <materialDesign:DrawerHost.Style>
                <Style TargetType="materialDesign:DrawerHost" BasedOn="{StaticResource {x:Type materialDesign:DrawerHost}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=BackgroundToggle}" Value="True">
                            <Setter Property="OverlayBackground" Value="{DynamicResource PrimaryHueMidBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </materialDesign:DrawerHost.Style>
            <materialDesign:DrawerHost.LeftDrawerContent>
                <Grid Background="{StaticResource Background}">
                    <Grid Grid.Column="0" Width="260" Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <!--#region Search-->

                        <StackPanel Grid.Row="0">
                            <DatePicker x:Name="searchTxtB"
                                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                        materialDesign:TextFieldAssist.LeadingIcon="Search"                              
                                        Margin="0 0 0 15"
                                        materialDesign:HintAssist.HintPaddingBrush="{StaticResource Background}"
                                        FontSize="14"
                                        BorderBrush="{StaticResource TextColor}"
                                        Foreground="{StaticResource TextColor}"
                                        materialDesign:ThemeAssist.Theme="Dark"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
                        </StackPanel>

                        <!--#endregion-->

                        <!--#region Filters-->

                        <UniformGrid x:Name="filterButtonUnit" Grid.Row="1" Margin="0 15 0 0" Columns="2">
                            <Button x:Name="viewFiltersBtn" Tag="true" Margin="0 0 5 0" Click="ExpendFilters_Click" />
                            <Button x:Name="hidenFiltersBtn" Margin="5 0 0 0" Click="ExpendFilters_Click" />
                        </UniformGrid>

                        <ScrollViewer x:Name="filterUnit" Grid.Row="2" VerticalScrollBarVisibility="Hidden" Focusable="False" Margin="-15 5 -15 0">
                            <materialDesign:Card Background="{StaticResource Background}" materialDesign:ElevationAssist.Elevation="Dp0" IsTabStop="False">
                                <StackPanel x:Name="filterContainer">
                                    <Expander x:Name="techniqueExpander" Background="{StaticResource Background}" Foreground="{StaticResource TextColor}">
                                        <StackPanel x:Name="techniqueContainer" Margin="24 8 24 16">
                                            <RadioButton x:Name="techNameRBtn" Style="{StaticResource RadioButtonFilter}" Checked="RadioButtonChanged_Checked" />
                                            <RadioButton x:Name="techTypeRBtn" Style="{StaticResource RadioButtonFilter}" Checked="RadioButtonChanged_Checked" />
                                            <RadioButton x:Name="techNumberRBtn" Style="{StaticResource RadioButtonFilter}" Checked="RadioButtonChanged_Checked" />
                                            <RadioButton x:Name="techCostRBtn" Style="{StaticResource RadioButtonFilter}" Checked="RadioButtonChanged_Checked" />
                                            <UniformGrid x:Name="costFields" Columns="2">
                                                <TextBox x:Name="costFromTxtB" PreviewTextInput="ValidationPrice_PreviewTextInput" />
                                                <TextBox x:Name="costToTxtB" PreviewTextInput="ValidationPrice_PreviewTextInput" />
                                            </UniformGrid>
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                    <Expander x:Name="responsibleExpander" Background="{StaticResource Background}" Foreground="{StaticResource TextColor}">
                                        <StackPanel x:Name="responsibleContainer" Margin="24 8 24 16">
                                            <RadioButton x:Name="respEmployeeRBtn" Style="{StaticResource RadioButtonFilter}" Checked="RadioButtonChanged_Checked" />
                                            <RadioButton x:Name="respNumberRBtn" Style="{StaticResource RadioButtonFilter}" Checked="RadioButtonChanged_Checked" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                    <Expander x:Name="computerExpander" Background="{StaticResource Background}" Foreground="{StaticResource TextColor}">
                                        <StackPanel x:Name="computerContainer" Margin="24 8 24 16">
                                            <RadioButton x:Name="compNumberRBtn" Style="{StaticResource RadioButtonFilter}" Checked="RadioButtonChanged_Checked" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                    <Expander x:Name="dateExpander" Background="{StaticResource Background}" Foreground="{StaticResource TextColor}">
                                        <StackPanel x:Name="dateContainer" Margin="24 8 24 16">
                                            <RadioButton x:Name="dateAcquisitionRBtn" Style="{StaticResource RadioButtonFilter}" Checked="RadioButtonChanged_Checked" />
                                            <RadioButton x:Name="dateProductionRBtn" Style="{StaticResource RadioButtonFilter}" Checked="RadioButtonChanged_Checked" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                    <Expander x:Name="suppliersExpander"  Background="{StaticResource Background}" Foreground="{StaticResource TextColor}">
                                        <StackPanel x:Name="suppliersContainer" Margin="24 8 24 16">
                                            <RadioButton x:Name="supNameRBtn" Style="{StaticResource RadioButtonFilter}" Checked="RadioButtonChanged_Checked" />
                                        </StackPanel>
                                    </Expander>
                                    <Border Background="{StaticResource HintColor}" Height="2" />
                                </StackPanel>
                            </materialDesign:Card>
                        </ScrollViewer>

                        <!-- #endregion -->

                        <!--#region Control panel-->

                        <StackPanel Grid.Row="3">
                            <materialDesign:DrawerHost Margin="0 0 0 10" OpenMode="Standard" BottomDrawerBackground="{DynamicResource SecondaryHueLightBrush}">
                                <materialDesign:DrawerHost.Style>
                                    <Style TargetType="materialDesign:DrawerHost" BasedOn="{StaticResource {x:Type materialDesign:DrawerHost}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=BackgroundToggle}" Value="True">
                                                <Setter Property="OverlayBackground" Value="{DynamicResource PrimaryHueMidBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:DrawerHost.Style>
                                <materialDesign:DrawerHost.BottomDrawerContent>
                                    <StackPanel Background="Transparent">
                                        <ComboBox x:Name="templateQueriesCB"
                                                  Foreground="{StaticResource TextColor}"
                                                  FontSize="14"
                                                  materialDesign:ThemeAssist.Theme="Dark"
                                                  materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource TextColor}">
                                            <ComboBoxItem Content="Пример 1" />
                                            <ComboBoxItem Content="Пример 2" />
                                        </ComboBox>

                                        <Grid Margin="0 15 0 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <TextBlock x:Name="absentTxtB" Grid.Column="0" Grid.Row="0" Foreground="{StaticResource TextColor}" VerticalAlignment="Center" />
                                            <ListBox x:Name="absentListB" Style="{StaticResource MaterialDesignChoiceChipOutlineListBox}" Grid.Column="2" Grid.Row="0">
                                                <ListBoxItem Foreground="{StaticResource TextColor}" Content="{materialDesign:PackIcon Kind=Check, Size=15}" />
                                                <ListBoxItem Foreground="{StaticResource TextColor}" Content="{materialDesign:PackIcon Kind=Minus, Size=15}" IsSelected="True" />
                                                <ListBoxItem Foreground="{StaticResource TextColor}" Content="{materialDesign:PackIcon Kind=Close, Size=15}" />
                                            </ListBox>
                                            <TextBlock x:Name="repairTxtB" Grid.Column="0" Grid.Row="1" Foreground="{StaticResource TextColor}" VerticalAlignment="Center" />
                                            <ListBox x:Name="repairListB" Style="{StaticResource MaterialDesignChoiceChipOutlineListBox}" Grid.Column="2" Grid.Row="1">
                                                <ListBoxItem Foreground="{StaticResource TextColor}" Content="{materialDesign:PackIcon Kind=Check, Size=15}" />
                                                <ListBoxItem Foreground="{StaticResource TextColor}" Content="{materialDesign:PackIcon Kind=Minus, Size=15}" IsSelected="True" />
                                                <ListBoxItem Foreground="{StaticResource TextColor}" Content="{materialDesign:PackIcon Kind=Close, Size=15}" />
                                            </ListBox>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:DrawerHost.BottomDrawerContent>
                                <StackPanel Margin="0 0 9 0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ToggleButton materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon ArrowCollapseDown}"
                                                  Content="{materialDesign:PackIcon Kind=ArrowExpandUp}"
                                                  CommandParameter="{x:Static Dock.Bottom}"
                                                  Click="ToggleGridBtn_Click" />
                                </StackPanel>
                            </materialDesign:DrawerHost>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="findBtn" Grid.Column="0" />
                                <Button x:Name="cleanBtn" 
                                        Content="{materialDesign:PackIcon Kind=CloseBoxOutline, Size=20}" 
                                        Grid.Column="2"
                                        Click="CleanTheForm_Click" />
                            </Grid>
                        </StackPanel>

                        <!--#endregion-->
                    </Grid>
                    <Border Background="{StaticResource SecondaryColor}" HorizontalAlignment="Right" Width="2" />
                </Grid>
            </materialDesign:DrawerHost.LeftDrawerContent>
            <StackPanel Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                <ToggleButton materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon ArrowCollapseLeft}"
                              Content="{materialDesign:PackIcon ArrowExpandRight}"
                              IsChecked="True"
                              Click="ToggleGridBtn_Click" />
            </StackPanel>
        </materialDesign:DrawerHost>

        <!--#endregion-->

        <!--#region Table-->

        <Grid Grid.Column="1">
            <Frame x:Name="tableFrame" IsTabStop="False" NavigationUIVisibility="Hidden" />
            
            <materialDesign:Snackbar x:Name="notificationSnackbar" 
                                     Grid.Column="1"
                                     Margin="-44 0 0 0"
                                     HorizontalAlignment="Stretch"
                                     MessageQueue="{materialDesign:MessageQueue}"
                                     Background="{StaticResource Background}" />
        </Grid>

        <!--#endregion-->
    </Grid>
</Page>
