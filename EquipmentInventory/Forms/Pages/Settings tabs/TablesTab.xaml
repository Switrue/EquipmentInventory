<UserControl x:Class="EquipmentInventory.Forms.Pages.Settings_tabs.TablesTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EquipmentInventory.Forms.Pages.Settings_tabs"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">
    <!--#region Styles-->

    <UserControl.Resources>
        <ResourceDictionary Source="/Resources/Styles/UserStyles.xaml" />
    </UserControl.Resources>

    <!--#endregion-->

    <Grid>
        <!--#region Tab body-->
        <StackPanel>
            <TextBlock x:Name="titleTab" Style="{StaticResource setupTabHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="yearOfObsolescenceCB" 
                          Grid.Column="0"
                          VerticalAlignment="Top"
                          ItemsSource="{Binding LongIntegerList}"
                          SelectedItem="{Binding SelectedLongInteger}">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
                <materialDesign:PackIcon x:Name="toolTipYearOfObsolescence" 
                                         Kind="InformationSlabCircleOutline" 
                                         Grid.Column="1"
                                         Margin="5"
                                         Background="Transparent"
                                         VerticalAlignment="Center"
                                         Foreground="{StaticResource SecondaryColor}" />
            </Grid>
        </StackPanel>
        
        <!--#endregion-->
    </Grid>
</UserControl>
