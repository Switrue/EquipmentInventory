<UserControl x:Class="EquipmentInventory.Forms.Pages.Settings_tabs.TablesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EquipmentInventory.Forms.Pages.Settings_tabs"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!--#region Styles-->
    <UserControl.Resources>
        <ResourceDictionary Source="/Resources/Styles/UserStyles.xaml" />
    </UserControl.Resources>
    <!--#endregion-->

    <Grid>
        <!--#region Tab body-->
        <StackPanel>
            <TextBlock x:Name="titleTab" Style="{StaticResource SetupTabHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <ComboBox x:Name="yearOfObsolescenceCB" 
                          Grid.Column="0"
                          Grid.Row="0"
                          VerticalAlignment="Top"
                          ItemsSource="{Binding LongIntegerList}"
                          SelectedItem="{Binding SelectedLongInteger}">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
                <materialDesign:PackIcon x:Name="toolTipYearOfObsolescence" 
                                         Grid.Column="1"
                                         Grid.Row="0"
                                         Margin="5"
                                         Style="{StaticResource BaseInformation}" />

                <ComboBox x:Name="numberOfRecordsCB" 
                          Grid.ColumnSpan="2"
                          Grid.Row="1"
                          ItemsSource="{Binding ShortIntegerList}"
                          SelectedItem="{Binding SelectedShortInteger}">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
            </Grid>
        </StackPanel>
        <!--#endregion-->
    </Grid>
</UserControl>
