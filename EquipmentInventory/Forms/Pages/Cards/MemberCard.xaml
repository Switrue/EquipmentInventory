<UserControl x:Class="EquipmentInventory.Forms.Pages.Cards.MemberCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EquipmentInventory.Classes.Data.Converters"
             xmlns:props="clr-namespace:EquipmentInventory.Properties"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!--#region Styles-->
    <UserControl.Resources>
        <ResourceDictionary>
            <local:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/TablesStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--#endregion-->

    <StackPanel>
        <StackPanel VerticalAlignment="Top" Margin="0 0 0 15">
            <TextBlock Text="{Binding Id, UpdateSourceTrigger=PropertyChanged, StringFormat='Id: {0}'}"
                       Foreground="{StaticResource HintColor}"
                       Visibility="{Binding Id, Converter={StaticResource ValueToVisibilityConverter}}"
                       Style="{StaticResource FieldTextBlock}" />
            <TextBox Text="{Binding Item.Surname, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldTextBox}"
                     MaxLength="60"
                     materialDesign:HintAssist.Hint="{x:Static props:Strings.FirstName}" />
            <TextBox Text="{Binding Item.Username, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldTextBox}"
                     MaxLength="60"
                     materialDesign:HintAssist.Hint="{x:Static props:Strings.SecondName}" />
            <ComboBox SelectedValue="{Binding Item.IdPosition, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding PositionItems}" 
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      materialDesign:HintAssist.Hint="{x:Static props:Strings.Position}"
                      Style="{StaticResource FieldComboBox}">
                <ComboBox.ItemContainerStyle>
                    <StaticResource ResourceKey="ComboBoxItemStyle" />
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </StackPanel>

        <Button Style="{StaticResource DefaultButton}"
                VerticalAlignment="Bottom"
                Command="{Binding SaveItemCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                Content="{x:Static props:Strings.Save}" />
    </StackPanel>
</UserControl>
