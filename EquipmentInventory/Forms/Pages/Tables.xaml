<UserControl x:Class="EquipmentInventory.Forms.Pages.Tables"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EquipmentInventory.Forms.Pages"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="450" d:DesignWidth="800">
    <!--#region Styles-->
    
    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}">
                <Setter Property="Margin" Value="5" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="IsEnabled" Value="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" />
                <Setter Property="ContentTemplate" Value="{StaticResource IconTemplateSize}" />
                <Setter Property="Content" Value="{Binding}" />
            </Style>

            <Style TargetType="materialDesign:Card">
                <Setter Property="Width" Value="270" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp8" />
            </Style>

            <Style TargetType="Image" BasedOn="{StaticResource ImageHoverStyle}">
                <Setter Property="Stretch" Value="Uniform" />
            </Style>

            <Style x:Key="textFieldGrid" TargetType="Grid">
                <Setter Property="Background" Value="{StaticResource GradientTransparent}" />
                <Setter Property="Height" Value="80" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}" />
            </Style>

            <Style x:Key="TitleCardTextBlock" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <!--#endregion-->
    
    <Grid>
        <!--#region Table section-->
        <StackPanel Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="titleBlockTxtBl" Grid.Column="0" Foreground="{StaticResource TextColor}"/>
                <Border BorderBrush="{StaticResource HintColor}" Grid.Column="2" BorderThickness="2" Height="1" />
            </Grid>

            <!--#region Cards-->
            
            <WrapPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="5">
                <!-- #region Сard archive -->

                <materialDesign:Card>
                    <Grid>
                        <StackPanel>
                            <Image Source="/Resources/Pictures/ArchivePreview.jpg" />
                        </StackPanel>

                        <Grid Style="{StaticResource textFieldGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="GoToArchive_Click" />
                            <StackPanel Grid.Column="1" Margin="5" VerticalAlignment="Center">
                                <TextBlock x:Name="titleArchiveCardTxtBl" Style="{StaticResource TitleCardTextBlock}" />
                                <TextBlock x:Name="descriptionArchiveCardTxtBl" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </materialDesign:Card>

                <!-- #endregion -->

                <!-- #region Card inventory -->

                <materialDesign:Card>
                    <Grid>
                        <StackPanel>
                            <Image Source="/Resources/Pictures/InvenotryPreview.jpg" />
                        </StackPanel>

                        <Grid Style="{StaticResource textFieldGrid}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="GoToInventory_Click" />
                            <StackPanel Grid.Column="1" Margin="5" VerticalAlignment="Center">
                                <TextBlock x:Name="titleInventoryCardTxtBl" Style="{StaticResource TitleCardTextBlock}" />
                                <TextBlock x:Name="descriptionInventoryCardTxtBl" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </materialDesign:Card>

                <!-- #endregion -->
            </WrapPanel>
            
            <!--#endregion-->
        </StackPanel>
        
        <!--#endregion-->
    </Grid>
</UserControl>
