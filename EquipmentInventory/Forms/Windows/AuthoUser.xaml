<Window x:Class="EquipmentInventory.Forms.Windows.AuthoUser "
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EquipmentInventory.Forms.Windows"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:windowChrome="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Style="{StaticResource MaterialDesignWindow}"
        Background="{StaticResource GradientBackgroundBrush}"
        mc:Ignorable="d"
        Height="450" Width="350"
        ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <windowChrome:WindowChrome.WindowChrome>
        <windowChrome:WindowChrome 
            CaptionHeight="0" 
            CornerRadius="20" 
            GlassFrameThickness="0" 
            ResizeBorderThickness="0"/>
    </windowChrome:WindowChrome.WindowChrome>

    <!-- Внешний Border для границы -->
    <Border BorderBrush="{StaticResource Circuit}" BorderThickness="1.5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- #region Header -->

            <Border Height="30" Grid.Row="0" CornerRadius="10 10 0 0"
                    Background="{StaticResource Foreground}" MouseLeftButtonDown="DragWindow_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="authoTitle" TextWrapping="Wrap" TextAlignment="Center" 
                               VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource HintColor}" />
                    <WrapPanel HorizontalAlignment="Right">
                        <Button x:Name="collapseBtn" Cursor="Hand" IsTabStop="False"
                                Content="{materialDesign:PackIcon Kind=Minus}"
                                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                Style="{StaticResource MaterialDesignFlatSecondaryLightButton}"
                                Padding="10 0 10 0" Click="CollapseWindow_Click" 
                                Foreground="{StaticResource HintColor}" />
                        <Button x:Name="closeBtn" Cursor="Hand" IsTabStop="False" 
                                Content="{materialDesign:PackIcon Kind=Close}"
                                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                Style="{StaticResource MaterialDesignFlatSecondaryLightButton}"
                                Padding="10 0 10 0" Click="CloseWindow_Click" 
                                materialDesign:RippleAssist.Feedback="{StaticResource AccentColor}"
                                Foreground="{StaticResource HintColor}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- #endregion -->

            <!-- #region Body -->

            <Grid Grid.Row="1" Cursor="">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="200" Grid.Row="0">
                    <TextBox x:Name="usernameTextB" Margin="0 0 0 10" MaxLength="60"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             materialDesign:TextFieldAssist.LeadingIcon="User"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             Foreground="{StaticResource TextColor}" />
                    <PasswordBox x:Name="passwordPsB" Margin="0 10 0 10" MaxLength="60"
                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="KeyVariant"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                                 Foreground="{StaticResource TextColor}" />
                    <CheckBox x:Name="rememberUserChB" Margin="0 10 0 0" 
                              Foreground="{StaticResource HintColor}"
                              Style="{StaticResource MaterialDesignSecondaryCheckBox}" />
                    <Button x:Name="loginBtn" Cursor="Hand" Margin="0 70 0 0"
                            materialDesign:RippleAssist.Feedback="#DD000000"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                            Click="Login_Click" />
                </StackPanel>
            </Grid>

            <!-- #endregion -->
        </Grid>
    </Border>
</Window>