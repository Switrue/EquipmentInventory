<Window x:Class="EquipmentInventory.Forms.Windows.AuthoUser "
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EquipmentInventory.Forms.Windows"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown"
        Height="450" Width="350">
    <Border Style="{StaticResource WindowBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--#region Header-->

            <Border Grid.Row="0" Style="{StaticResource TitleBarBorder}" MouseLeftButtonDown="DragWindow_MouseLeftButtonDown">
                <Grid Margin="2.5">
                    <TextBlock x:Name="windowTitle" Style="{StaticResource WindowTitleTextBlock}" />
                    <WrapPanel HorizontalAlignment="Right">
                        <Button x:Name="collapseBtn" Style="{StaticResource CollapseButton}" Click="CollapseWindow_Click" />
                        <Button x:Name="closeBtn" Style="{StaticResource CloseButton}" Click="CloseWindow_Click" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!--#endregion-->

            <!--#region Body-->

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="200" Grid.Row="0">
                    <StackPanel x:Name="textFieldContainer">
                        <TextBox x:Name="usernameTextB" 
                                 Margin="0 0 0 10" 
                                 MaxLength="60"
                                 FontSize="{DynamicResource DefaultFontSize}"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="User"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 BorderBrush="{StaticResource HintColor}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 Foreground="{StaticResource TextColor}" 
                                 TextChanged="TextBox_TextChanged" />
                        <PasswordBox x:Name="passwordPsB" 
                                     Margin="0 10 0 10" 
                                     MaxLength="60"
                                     FontSize="{DynamicResource DefaultFontSize}"
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="KeyVariant"
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                                     materialDesign:ThemeAssist.Theme="Dark"
                                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                     Foreground="{StaticResource TextColor}"
                                     PasswordChanged="PasswordBox_PasswordChanged" />
                    </StackPanel>
                    <CheckBox x:Name="rememberUserChB" 
                              Margin="0 10 0 0" 
                              FontSize="{DynamicResource DefaultFontSize}"
                              Foreground="{StaticResource HintColor}"
                              Style="{StaticResource MaterialDesignSecondaryCheckBox}" />
                    <Button x:Name="loginBtn" 
                            Margin="0 70 0 0" 
                            Style="{StaticResource DefaultButton}"
                            Click="Login_Click" />
                </StackPanel>
            </Grid>

            <!--#endregion-->
        </Grid>
    </Border>
</Window>