<Window x:Class="EquipmentInventory.Forms.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EquipmentInventory"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource MaterialDesignWindow}"
        mc:Ignorable="d" 
        Background="Transparent"
        AllowsTransparency="True"
        Height="600" 
        Width="1000"
        MinHeight="500" 
        MinWidth="800"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged">

    <Border x:Name="windowEdging" Style="{StaticResource WindowBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="85" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- #region Header -->

            <Border x:Name="windowBorder" Grid.Row="0" Style="{StaticResource TitleBarBorder}" MouseLeftButtonDown="DragWindow_MouseLeftButtonDown">
                <StackPanel Orientation="Vertical" Margin="2.5">
                    <Grid>
                        <WrapPanel HorizontalAlignment="Left">
                            <!-- #region Menu -->

                            <StackPanel VerticalAlignment="Center">
                                <Menu IsMainMenu="True" 
                                      FontSize="12" 
                                      Background="{StaticResource Foreground}"
                                      materialDesign:MenuAssist.TopLevelMenuItemHeight="-1"
                                      materialDesign:MenuAssist.MenuItemsPresenterMargin="0 5 0 5"
                                      materialDesign:RippleAssist.IsDisabled="True"
                                      Cursor="Hand">
                                    <MenuItem x:Name="fileMnIt" 
                                              Padding="10"
                                              materialDesign:MenuItemAssist.HighlightedBackground="Transparent"
                                              Foreground="{StaticResource HintColor}"
                                              Background="{StaticResource Foreground}">
                                        <MenuItem x:Name="settingsMnIt"
                                                  Icon="{materialDesign:PackIcon Kind=Settings}"
                                                  Click="Settings_Click" />
                                    </MenuItem>

                                    <MenuItem x:Name="helpMnIt" 
                                              Padding="10"
                                              materialDesign:MenuItemAssist.HighlightedBackground="Transparent"
                                              Foreground="{StaticResource HintColor}"
                                              Background="{StaticResource Foreground}">
                                        <MenuItem x:Name="aboutTheProgrammMnIt" 
                                                  InputGestureText="Ctrl+F1"
                                                  Icon="{materialDesign:PackIcon Kind=Information}"
                                                  Click="AboutTheProgramm_Click" />
                                    </MenuItem>
                                </Menu>
                            </StackPanel>

                            <!-- #endregion -->
                        </WrapPanel>

                        <WrapPanel HorizontalAlignment="Right">
                            <!-- #region Manager Account -->

                            <StackPanel VerticalAlignment="Center">
                                <Button x:Name="manageAccountBtn" 
                                        Cursor="Hand" 
                                        Padding="10 4 10 4" 
                                        IsTabStop="False"
                                        IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                        Style="{StaticResource MaterialDesignFlatSecondaryButton}"
                                        Background="Transparent" 
                                        Click="ShowProfileOptions_Click">
                                    <WrapPanel>
                                        <Border Background="Black">
                                            <Image Source="/Resources/Pictures/SmallUserIcon.png" />
                                        </Border>
                                        <Border Width="2" Background="{StaticResource SecondaryColor}" Margin="0 0 4 0"/>
                                        <TextBlock x:Name="userNameTexB" 
                                                   VerticalAlignment="Center" 
                                                   MaxWidth="120" 
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" 
                                                   Foreground="{StaticResource SecondaryColor}" />
                                    </WrapPanel>
                                </Button>

                                <Popup x:Name="actionsPopup" PlacementTarget="{Binding ElementName=manageAccountBtn}" 
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <StackPanel Background="{StaticResource Background}">
                                        <Button x:Name="profileBtn" HorizontalContentAlignment="Left"
                                                Foreground="{StaticResource HintColor}"
                                                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                                Style="{StaticResource MaterialDesignFlatSecondaryDarkButton}"
                                                Click="Profile_Click" />
                                        <Border Height="1" Background="{StaticResource HintColor}" />
                                        <Button x:Name="logOutBtn" HorizontalContentAlignment="Left"
                                                Foreground="{StaticResource HintColor}" Click="Logout_Click"
                                                IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                                Style="{StaticResource MaterialDesignFlatSecondaryDarkButton}" />
                                    </StackPanel>
                                </Popup>
                            </StackPanel>

                            <!-- #endregion -->

                            <!-- #region Window options -->

                            <Button x:Name="collapseBtn" Style="{StaticResource CollapseButton}" Click="CollapseWindow_Click" />
                            <Button x:Name="maximizeBtn" Style="{StaticResource MaximizeButton}" Click="MaximizeWindow_Click" />
                            <Button x:Name="closeBtn" Style="{StaticResource CloseButton}" Click="CloseWindow_Click" />

                            <!-- #endregion -->
                        </WrapPanel>
                    </Grid>

                    <Grid>
                        <WrapPanel>
                            <!-- #region Control panel -->

                            <Frame x:Name="controlPanelFrame" IsTabStop="False" NavigationUIVisibility="Hidden" Margin="4 0 0 0" />

                            <!-- #endregion -->
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- #endregion -->

            <!--#region Body-->

            <Grid Grid.Row="1">
                <Frame x:Name="mainFrame" IsTabStop="False" NavigationUIVisibility="Hidden" />
            </Grid>

            <!-- #endregion -->

            <!-- #region Footer -->

            <Border x:Name="footerBorder" Grid.Row="2" Style="{StaticResource FooterBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Background="Transparent" MouseLeftButtonDown="DragWindow_MouseLeftButtonDown" />

                    <Rectangle x:Name="resizeMarker" 
                               Grid.Column="1"
                               Width="20" 
                               Height="20" 
                               Margin="4" 
                               Cursor="SizeNWSE"
                               HorizontalAlignment="Right" 
                               Fill="{StaticResource HintColor}"
                               MouseMove="ResizeHandle_MouseMove" 
                               MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" 
                               MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Resources/Pictures/Expand.png" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Grid>
            </Border>

            <!-- #endregion -->
        </Grid>
    </Border> 
</Window>
