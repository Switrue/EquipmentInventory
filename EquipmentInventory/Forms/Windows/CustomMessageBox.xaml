<Window x:Class="EquipmentInventory.Forms.Windows.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EquipmentInventory.Forms.Windows"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:windowChrome="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        ResizeMode="NoResize" SizeToContent="Height" 
        Background="{StaticResource GradientBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        MinHeight="200 " Width="400">

    <windowChrome:WindowChrome.WindowChrome>
        <windowChrome:WindowChrome 
             CaptionHeight="0" 
             CornerRadius="20" 
             GlassFrameThickness="0" 
             ResizeBorderThickness="0"/>
    </windowChrome:WindowChrome.WindowChrome>

    <!-- Внешний Border для границы -->
    <Border BorderBrush="{StaticResource Circuit}" BorderThickness="1.5" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- #region Header -->

            <Border Background="{StaticResource Foreground}" Height="30" CornerRadius="10 10 0 0"
                    MouseLeftButtonDown="DragWindow_MouseLeftButtonDown" Grid.Row="0">
                <Grid>
                    <TextBlock x:Name="customMessageBoxTitle" TextWrapping="Wrap" TextAlignment="Center" 
                               VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource HintColor}" />
                    <Button x:Name="closeBtn" 
                            Content="{materialDesign:PackIcon Kind=Close}"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignFlatSecondaryLightButton}"
                            Padding="10 0 10 0" HorizontalAlignment="Right"
                            Foreground="{StaticResource HintColor}"
                            materialDesign:RippleAssist.Feedback="{StaticResource AccentColor}"
                            Click="CloseWindow_Click" Cursor="Hand" IsTabStop="False" />
                </Grid>
            </Border>

            <!-- #endregion -->

            <!-- #region Body -->

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="messageTxtB" TextWrapping="Wrap" Grid.Row="0" TextAlignment="Justify"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Margin="10" />

                <WrapPanel Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10">
                    <Button x:Name="trueBtn" Width="60" Margin="5 0 5 0"
                            materialDesign:RippleAssist.Feedback="#DD000000"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                            Click="ReturnTrue_Click" />
                    <Button x:Name="falseBtn" Width="60" Margin="5 0 5 0" 
                            materialDesign:RippleAssist.Feedback="#DD000000"
                            IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            Style="{StaticResource MaterialDesignRaisedSecondaryButton}"
                            Click="ReturnFalse_Click" Visibility="Collapsed" />
                </WrapPanel>
            </Grid>

            <!-- #endregion -->
        </Grid>
    </Border>
</Window> 
