<Window x:Class="EquipmentInventory.Forms.Windows.ProgramSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EquipmentInventory.Forms.Windows"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown"
        Height="550" Width="500">
    <Border Style="{StaticResource WindowBorder}">
        <Grid>
            <!--#region Settings body-->

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" MinWidth="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--#region Tabs-->
                
                <Border Grid.Column="0" Background="{StaticResource Background}" CornerRadius="10 0 0 10">
                    <StackPanel>
                        <TextBlock x:Name="windowTitle" 
                                   Padding="0,16"
                                   Foreground="{StaticResource SecondaryColor}" 
                                   Style="{StaticResource WindowTitleTextBlock}" />
                        
                        <ListView Foreground="{StaticResource TextColor}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  VerticalContentAlignment="Center">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="5">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" VerticalAlignment="Center" />
                                        <Border BorderBrush="{StaticResource HintColor}" BorderThickness="1" Margin="5 0 5 0" />
                                        <TextBlock Text="{Binding Title}" 
                                                   FontSize="{DynamicResource DefaultFontSize}" 
                                                   MaxWidth="100" 
                                                   TextWrapping="Wrap" />
                                    </WrapPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{StaticResource SecondaryColor}" BorderThickness="1" HorizontalAlignment="Right" />

                <!--#endregion -->

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--#region Header-->
                    
                    <Border Grid.Row="0"  VerticalAlignment="Top" Style="{StaticResource TitleBarBorder}" MouseLeftButtonDown="DragWindow_MouseLeftButtonDown">
                        <Grid Margin="2.5">
                            <WrapPanel HorizontalAlignment="Right">
                                <Button x:Name="closeBtn" Style="{StaticResource CloseButton}" Click="CloseWindow_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!--#endregion-->
                    
                    <!--#region Tab field-->
                    
                    <Border Grid.Row="1" Background="{StaticResource Foreground}" CornerRadius="0 0 10 0">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="5" Focusable="False">
                            <ContentControl x:Name="settingsFrame" Focusable="False" />
                        </ScrollViewer>
                    </Border>
                    
                    <!--#endregion-->
                </Grid>
            </Grid> 

            <!--#endregion-->
        </Grid>
    </Border>
</Window>
